# Source distributions contain the installed package and user-facing metadata,
# not repository-only tests, benchmarks, automation, or local configuration.
include CHANGELOG.md
include LICENSE
include README.md
graft src

prune .devcontainer
prune .github
prune benchmarks
prune docs
prune tests

exclude .codespell-ignore-words.txt
exclude .editorconfig
exclude .env.example
exclude .gitattributes
exclude .gitignore
exclude .pre-commit-config.yaml
exclude .python-version
exclude AGENTS.md
exclude CODE_OF_CONDUCT.md
exclude CONTRIBUTING.md
exclude Makefile
exclude RELEASING.md
exclude SECURITY.md
exclude TEMPLATE_SETUP.md
exclude uv.lock
exclude zizmor.yml

global-exclude __pycache__
global-exclude *.py[cod]
